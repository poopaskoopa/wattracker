# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
# packaged release artifacts (DMG/zip + checksums)
release/

# Databases
*.db
*.sqlite
*.sqlite3
*.sqlite-*

# User ride/workout data (never commit personal training files)
*.fit
*.FIT
*.zwo

# Environment / secrets / keys
.env
config.json
credentials.key
*.key
*.pem

# OS / editor
.DS_Store
.idea/
.vscode/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# runtime artifacts
.wattracker.pid
wattracker.log
*.log
nohup.out

# scratch / one-off scripts
scratch/
sanity*.py
tmp/

# local agent/editor tooling settings (may contain machine-specific paths)
.claude/settings.local.json

# Xcode (ios/)
# xcuserdata holds per-developer window state, breakpoints and the non-shared
# schemes; the shared scheme in xcshareddata IS committed, because xcodebuild
# needs it. DerivedData and build products never are.
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.xcworkspace/xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
