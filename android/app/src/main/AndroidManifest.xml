<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        The only permission the app needs, now or later: it talks to the cloud
        and to the local desktop server, both over HTTPS — the local one behind
        whatever TLS terminator the rider runs, tailscale serve or an ordinary
        reverse proxy (owner decision, #192/#260).
        No camera, no location, nothing else.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Backup is off: Step 2 adds non-exportable Keystore-wrapped
        credentials; a restored blob would be undecryptable. The gate is
        allowBackup="false" itself: the rule files it points at carry no
        include rules (an empty rule set would include everything if backup
        were ever re-enabled), so they exist only to give the attributes
        something to point at. The one load-bearing content is the
        <device-transfer> exclude in data_extraction_rules.xml: Android 12+
        device-to-device transfer ignores allowBackup and, with no rules at
        all, would transfer everything. Revisit with real rules when the
        policy is decided.
    -->
    <application
        android:name=".WatTrackerApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.WatTracker">
        <!--
            Cleartext is controlled by network_security_config. The debug
            build overrides the config resource of the same name to permit
            cleartext to loopback hosts only (the dev harness seen through
            the emulator); the release form of the resource stays strict.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.WatTracker"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
