<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        The only permission the app needs, now or later: it talks to the cloud
        (HTTPS) and, on the rider's own LAN, to the local desktop server.
        No camera, no location, nothing else.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Backup is off: Step 2 adds non-exportable Keystore-wrapped credentials;
        a restored blob would be undecryptable. Revisit with real exclude rules
        when the backup policy is decided.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.WatTracker">
        <!--
            Cleartext is controlled by network_security_config. The debug
            build overrides the config resource of the same name to permit
            cleartext to loopback hosts only (the dev harness seen through
            the emulator); the release form of the resource stays strict.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.WatTracker"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
