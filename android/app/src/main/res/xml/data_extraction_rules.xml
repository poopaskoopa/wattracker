<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing may leave the device, by either door. allowBackup="false" closes
    cloud backup, but Android 12+ device-to-device transfer ignores that
    attribute and reads only this file; with no <device-transfer> rules at
    all, the transfer defaults to including everything. (The device_* domain
    variants name device-protected storage, which this app does not use; the
    plain domains cover its ordinary app data.)

    The app's entire on-disk state is excluded across all domains (root,
    database, sharedpref, file, external), including the Room cache (database)
    and EncryptedSharedPreferences (sharedpref). The signing key itself is in
    the Keystore, which no transfer mechanism can carry. See AndroidManifest.xml.
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
