<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>WatTracker</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Both come from build settings (Config/Base.xcconfig holds the local
	     defaults) rather than being literals, because the TestFlight release
	     job must set them per run: App Store Connect rejects a build number it
	     has already accepted for a given version string. See
	     .github/workflows/ios-release.yml. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<!-- Orientation is split by idiom, and the split is not cosmetic.

	     iPhone: landscape only, and the system enforces it. Every layout in
	     this app is designed for a wide, short viewport (~874x402pt on an
	     iPhone 17 Pro), so portrait is an orientation the phone does not have.

	     iPad: all four, because as of iPadOS 26 the choice is not ours. An app
	     built against the iOS 26 SDK joins the new iPad windowing system, where
	     a window is resizable and this list no longer locks it; issue #171
	     measured a landscape-only list plus UIRequiresFullScreen plus a runtime
	     requestGeometryUpdate all failing to stop a portrait iPad window.
	     Declaring all four states what actually happens instead of asking for a
	     guarantee the platform stopped providing. The standing requirement that
	     comes with it: every iPad layout must be correct in portrait -- not
	     necessarily optimal, but never broken. See ios/README.md and #158. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- UIRequiresFullScreen is deliberately absent. It was here to make the
	     orientation list stick on iPad; #171 measured that it does not do that
	     on iPadOS 26, and all it still does is opt the app out of multitasking
	     for no benefit we are getting. -->
	<!-- Asked for exactly once, on the pairing screen, and only when the rider
	     taps "Use the camera". The purpose string names the single thing the
	     camera is used for because that is all it is used for: reading the QR
	     form of a pairing code. Nothing in this app records, stores or uploads
	     an image -- the capture session's only output is an
	     AVCaptureMetadataOutput restricted to .qr. Refusing is supported
	     rather than tolerated: the code can always be typed instead, so a
	     denied camera costs the rider twelve keystrokes and nothing else. -->
	<key>NSCameraUsageDescription</key>
	<string>WatTracker uses the camera to scan the pairing code shown by the WatTracker app on your computer. You can also type the code instead.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Debug-only relaxation, and it cannot reach the public internet:
	     loopback and local-network hosts only, so a simulator build can talk
	     to a server on the developer's own machine over http (see
	     Config/Debug.xcconfig, which points WATTRACKER_API_HOST at
	     localhost:8765). This file is never the one that ships: Release uses
	     Info.plist, which carries no NSAppTransportSecurity key at all, so a
	     Release build gets ATS's default of no exceptions rather than
	     inheriting this one. INFOPLIST_FILE is what picks between the two, set
	     per configuration in the Xcode project. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<!-- Supplied by Config/*.xcconfig, never written as a literal in the
	     client: the app ships to TestFlight and a moved host must be a
	     configuration change and a rebuild, not a code change. -->
	<key>WATTRACKERAPIScheme</key>
	<string>$(WATTRACKER_API_SCHEME)</string>
	<key>WATTRACKERAPIHost</key>
	<string>$(WATTRACKER_API_HOST)</string>
</dict>
</plist>
